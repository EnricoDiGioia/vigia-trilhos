# Copie para .env e ajuste. Em hospedagem, cadastre cada uma como variável de ambiente.

# ---- coleta ----------------------------------------------------------------
# Intervalo da thread interna, em segundos. 0 desliga (use quando um cron externo
# estiver batendo em /api/cron/poll).
POLL_SEGUNDOS=60

# Piso entre dois ciclos, em segundos. Impede que o cron e a thread martelem juntos.
INTERVALO_MINIMO=25

# ---- ARTESP (opcional) -----------------------------------------------------
# Chave do Portal CCM. Sem ela o app roda normalmente, só sem o histórico oficial.
# Cadastro: https://ccm.artesp.sp.gov.br/contas/cadastro-solicitacao/
# Teto de 12 requisições/hora por credencial — não reduza o intervalo abaixo.
ARTESP_API_KEY=
ARTESP_INTERVALO_MIN=10

# ---- banco -----------------------------------------------------------------
# Caminho do arquivo SQLite. Em hospedagem com disco efêmero, aponte para um
# volume persistente se tiver um.
VIGIA_DB=vigia.db

# ---- e-mail (opcional) -----------------------------------------------------
# Sem SMTP_HOST a interface esconde a inscrição por e-mail e segue funcionando.
# No Gmail use uma senha de app, nunca a senha da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=
# Usada no link de cancelamento dentro do e-mail.
SITE_URL=https://seu-app.onrender.com

# ---- cron externo ----------------------------------------------------------
# Se definido, /api/cron/poll exige ?token=<valor>.
CRON_TOKEN=

# ---- desenvolvimento -------------------------------------------------------
# 1 popula ocorrências fictícias para conhecer a interface antes de haver histórico.
SEMEAR_DEMO=0
DEBUG=0
PORT=8000
